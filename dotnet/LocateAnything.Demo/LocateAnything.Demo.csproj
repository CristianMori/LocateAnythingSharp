<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Mori.LocateAnything.Demo</RootNamespace>
    <Authors>Cristian Mori</Authors>
    <Copyright>Copyright © 2026 Cristian Mori</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mori.LocateAnythingSharp\Mori.LocateAnythingSharp.csproj" />
  </ItemGroup>

  <!-- Native engine + CUDA runtime DLLs are copied next to the exe by
       scripts/package-native.ps1 (run once after building the C++ side). -->

</Project>
